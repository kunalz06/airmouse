<?xml version="1.0"?>
<!-- Passive static obstacle for 2D LiDAR scan geometry qualification, no flight. -->
<sdf version="1.9">
  <model name="nidar_lidar_target">
    <static>true</static>
    <pose>2 0 0.35 0 0 0</pose>
    <link name="target">
      <collision name="collision">
        <geometry><box><size>0.5 1.2 0.7</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 1.2 0.7</size></box></geometry>
      </visual>
    </link>
  </model>
</sdf>
