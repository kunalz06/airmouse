#!/bin/sh
# PX4 v1.17.0 MAVLink startup overlay for NIDAR Phase 2.
#
# Based on PX4-Autopilot d6f12ad1c4f70ad3230afd7d86e971421e02fef4,
# ROMFS/px4fmu_common/init.d-posix/px4-rc.mavlink.  The two final links are
# localhost-only observer outputs: QGroundControl receives UDP 14550 and the
# passive smoke listener receives UDP 14560.  They do not change parameters
# or issue vehicle commands.

udp_offboard_port_local=$((14580+px4_instance))
udp_offboard_port_remote=$((14540+px4_instance))
[ "$px4_instance" -gt 9 ] && udp_offboard_port_remote=14549
udp_onboard_payload_port_local=$((14280+px4_instance))
udp_onboard_payload_port_remote=$((14030+px4_instance))
udp_onboard_gimbal_port_local=$((13030+px4_instance))
udp_onboard_gimbal_port_remote=$((13280+px4_instance))
udp_gcs_port_local=$((18570+px4_instance))

# Upstream GCS link.
mavlink start -x -u $udp_gcs_port_local -r 4000000 -f
mavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -u $udp_gcs_port_local
mavlink stream -r 50 -s LOCAL_POSITION_NED -u $udp_gcs_port_local
mavlink stream -r 50 -s GLOBAL_POSITION_INT -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE_QUATERNION -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE_TARGET -u $udp_gcs_port_local
mavlink stream -r 50 -s SERVO_OUTPUT_RAW_0 -u $udp_gcs_port_local
mavlink stream -r 20 -s RC_CHANNELS -u $udp_gcs_port_local
mavlink stream -r 10 -s OPTICAL_FLOW_RAD -u $udp_gcs_port_local

# Upstream API/offboard link.
mavlink start -x -u $udp_offboard_port_local -r 4000000 -f -m onboard -o $udp_offboard_port_remote

# Upstream payload and gimbal links.
mavlink start -x -u $udp_onboard_payload_port_local -r 4000 -f -m onboard -o $udp_onboard_payload_port_remote
mavlink start -x -u $udp_onboard_gimbal_port_local -r 400000 -f -m gimbal -o $udp_onboard_gimbal_port_remote

if [ "$PX4_SIMULATOR" = "sihsim" ]; then
	udp_sihsim_port_local=$((19450+px4_instance))
	udp_sihsim_port_remote=$((19410+px4_instance))
	mavlink start -x -u $udp_sihsim_port_local -r 400000 -m custom -o $udp_sihsim_port_remote
	mavlink stream -r 200 -s HIL_ACTUATOR_CONTROLS -u $udp_sihsim_port_local
	mavlink stream -r 25 -s HIL_STATE_QUATERNION -u $udp_sihsim_port_local
fi

# NIDAR local observer links. PX4 binds the local ports; consumers bind only
# the remote ports below. No link accepts commands from a consumer.
nidar_qgc_port_local=14551
nidar_qgc_port_remote=14550
mavlink start -x -u $nidar_qgc_port_local -r 4000000 -f -t 127.0.0.1 -o $nidar_qgc_port_remote
mavlink stream -r 50 -s LOCAL_POSITION_NED -u $nidar_qgc_port_local

nidar_smoke_port_local=14561
nidar_smoke_port_remote=14560
mavlink start -x -u $nidar_smoke_port_local -r 4000000 -f -t 127.0.0.1 -o $nidar_smoke_port_remote
mavlink stream -r 50 -s LOCAL_POSITION_NED -u $nidar_smoke_port_local
